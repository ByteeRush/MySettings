{
    "editor.semanticHighlighting.enabled": false,
    "editor.fontFamily": "'Comic Mono'",
    //editor.fontFamily": "'Comic Mono','Victor Mono', 'Maple Mono', 'Monaspace Neon', 'JetBrains Mono'",
    "editor.fontSize": 18,
    "editor.fontWeight": "500",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.5,
    "editor.letterSpacing": 0,
    "terminal.integrated.fontFamily": "'Comic Mono'",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "expand",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.minimap.enabled": false,
    "editor.formatOnPaste": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "jetbrains-product-icon-theme",
    "workbench.colorTheme": "Inkglow Blaze",
    "workbench.browser.showInTitleBar": true,
    "workbench.sideBar.location": "right",
    "rust-analyzer.workspace.discoverConfig": null,
    "breadcrumbs.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "material-icon-theme.files.color": "#fdd835",
    "background.enabled": true,
    "background.fullscreen": {
        "images": ["file:///home/yasir/Pictures/kimono.jpg"],
        "opacity": 0.4,
        "size": "cover",
        "position": "center",
        "styles": [],
        "interval": 0,
        "random": false
    },
    "editor.wordWrap": "on"
}
